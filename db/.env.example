# Copy this to .env.local IN YOUR OWN BRANCH FOLDER (not inside db/) and
# fill in the connection string(s) your team lead gives you.
#
# creative / finance / marketing / distribution only need this one:
PRERELEASE_DATABASE_URL=

# scoring (and data-pipeline, to load results) also needs this one.
# Leave it blank if you're not the scoring branch -- you shouldn't have
# this value at all.
RESULTS_DATABASE_URL=
